# ---------------------------------------------------------------------------
# Docker Compose settings
# ---------------------------------------------------------------------------
# Backing services started by compose. Remove an entry to use an external
# service instead (and adjust DB_* / REDIS_* / MAIL_* below).
COMPOSE_PROFILES=db,redis,mail
COMPOSE_PROJECT_NAME=bmac
BMAC_IMAGE=bmac:latest

# Published ports (host_ip:port). The app is meant to sit behind a reverse
# proxy that terminates TLS.
APP_BIND=127.0.0.1:8080
DB_BIND=127.0.0.1:3306
REDIS_BIND=127.0.0.1:6379
MAILPIT_SMTP_BIND=127.0.0.1:1025
MAILPIT_UI_BIND=127.0.0.1:8025

# Run "php artisan migrate --force" when the app container starts.
AUTO_MIGRATE=true
# Programs supervised inside the app container (Caddy and php-fpm always run).
QUEUE_ENABLED=true
SCHEDULER_ENABLED=true
# Seconds supervisord waits for running jobs on shutdown.
QUEUE_STOP_WAIT=60
# Seconds to wait for the database on startup (0 disables the check).
DB_WAIT_TIMEOUT=60

# Only used by the bundled MariaDB container.
DB_ROOT_PASSWORD=change-me-root

# ---------------------------------------------------------------------------
# Container settings
# ---------------------------------------------------------------------------
# Networks allowed to set X-Forwarded-* headers: comma separated CIDRs,
# "private_ranges" or "*".
# Defaults to private_ranges when empty.
TRUSTED_PROXIES=private_ranges
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=25M
PHP_FPM_MAX_CHILDREN=20

# ---------------------------------------------------------------------------
# Laravel / BMAC settings (see the project README)
# ---------------------------------------------------------------------------
APP_NAME=BMAC
APP_ENV=production
# Generate with: docker run --rm bmac:latest php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://booking.example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BUGSNAG_API_KEY=
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=bmac
DB_USERNAME=bmac
DB_PASSWORD=change-me
DB_TABLE_PREFIX=
DB_LOWER_STRING_LENGTH=false

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# "smtp" (plain / opportunistic STARTTLS) or "smtps" (implicit TLS, port 465).
# Must be set explicitly: the application otherwise falls back to "tls",
# which Symfony Mailer does not accept.
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=booking@example.org
MAIL_FROM_NAME="${APP_NAME}"

# VATSIM Connect
OAUTH_BASE=https://auth.vatsim.net
OAUTH_CLIENT=
OAUTH_SECRET=
OAUTH_SCOPES="full_name,email"
OAUTH_MAPPING_CID=data-cid
OAUTH_MAPPING_FIRSTNAME=data-personal-name_first
OAUTH_MAPPING_LASTNAME=data-personal-name_last
OAUTH_MAPPING_EMAIL=data-personal-email

# Branding
SITE_TITLE="Booking"
SITE_DIVISION="Division Name"
SITE_DIVISION_URL="https://division.org"
SITE_CONTACT_MAIL="event@division.org"
SITE_PILOTBRIEF_URL="https://www.division.org/visiting-pilots/"
SITE_CHARTS_URL="https://www.division.org/charts/"

# Bootstrap colours are compiled into the CSS: changing them requires
# rebuilding the image (docker compose build).
BOOTSTRAP_COLOR_PRIMARY="#2C3E50"
BOOTSTRAP_COLOR_SECONDARY="#95a5a6"
BOOTSTRAP_COLOR_TERTIARY="#18BC9C"
BOOTSTRAP_COLOR_SUCCESS="#18BC9C"
BOOTSTRAP_COLOR_DANGER="#E74C3C"
BOOTSTRAP_COLOR_WARNING="#F39C12"

ACTIVITY_LOGGER_ENABLED=true
TELESCOPE_ENABLED=false
